[Unit]
Description=Gauroo private Ollama runtime
After=network-online.target

[Service]
Type=simple
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=%h/just/jiddaeng/gauroo-analysis/models
Environment=OLLAMA_NO_CLOUD=1
Environment=OLLAMA_NOHISTORY=1
Environment=OLLAMA_FLASH_ATTENTION=1
ExecStart=%h/.local/bin/ollama serve
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=default.target
